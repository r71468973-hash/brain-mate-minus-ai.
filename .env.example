# GEMINI_API_KEY: Optional Gemini API key for fallback inference.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for OpenAI backend intelligence.
# Configure this in your server environment / secrets. Never expose in frontend code.
OPENAI_API_KEY="sk-your-openai-api-key"

# OPENAI_MODEL: Supported model name (e.g., gpt-4o, gpt-4o-mini, gpt-4-turbo)
OPENAI_MODEL="gpt-4o"

# SUPER ADMIN PIN: Master PIN for owner controls (Default: 714689)
ADMIN_MASTER_PIN="714689"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
